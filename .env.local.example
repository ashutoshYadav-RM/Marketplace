# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used exclusively inside Edge Functions / server-only admin
# routes — never imported by client components, never prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
